<section
  id="DikadoinMascotCallout-{{ section.id }}"
  class="dikadoin-mascot-callout"
  style="
    --callout-bg: {{ section.settings.background_color }};
    --callout-text: {{ section.settings.text_color }};
    --callout-accent: {{ section.settings.accent_color }};
    --callout-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="page-width">
    <div class="dikadoin-mascot-callout__box">
      {% if section.settings.mascot != blank %}
        <div class="dikadoin-mascot-callout__media">
          {{
            section.settings.mascot
            | image_url: width: 700
            | image_tag:
              loading: 'lazy',
              widths: '240, 360, 480, 700',
              sizes: '(min-width: 750px) 220px, 160px',
              class: 'dikadoin-mascot-callout__image'
          }}
        </div>
      {% endif %}

      <div class="dikadoin-mascot-callout__content">
        {% if section.settings.kicker != blank %}
          <p class="dikadoin-mascot-callout__kicker">{{ section.settings.kicker | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="dikadoin-mascot-callout__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="dikadoin-mascot-callout__text rte">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="dikadoin-mascot-callout__link"
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          >
            {{ section.settings.button_label | escape }} <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #DikadoinMascotCallout-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__box {
    display: grid;
    grid-template-columns: minmax(160px, 240px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 52px);
    min-height: 260px;
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--callout-radius);
    background: var(--callout-bg);
    color: var(--callout-text);
    overflow: hidden;
  }

  #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__media {
    align-self: end;
  }

  #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__image {
    display: block;
    width: 100%;
    max-height: 230px;
    object-fit: contain;
    object-position: center bottom;
  }

  #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__content {
    max-width: 760px;
  }

  #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__kicker {
    margin: 0 0 8px;
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .68;
  }

  #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1.08;
  }

  #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__text {
    margin-top: 12px;
    max-width: 660px;
    line-height: 1.6;
  }

  #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__link {
    display: inline-flex;
    gap: 7px;
    margin-top: 18px;
    color: var(--callout-accent);
    text-decoration: none;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__box {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 26px;
      text-align: center;
    }

    #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__media {
      width: 150px;
      justify-self: center;
    }

    #DikadoinMascotCallout-{{ section.id }} .dikadoin-mascot-callout__link {
      justify-content: center;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "DikadoIn — Mascot callout",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "mascot", "label": "Mascot image" },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "A note from the gang" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Kadang yang bikin kado spesial bukan harganya, tapi ceritanya." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose something small, add a little personal touch, and make it feel like it was always meant for them.</p>" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Find something special" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#E9E1F4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4B342D" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#9B5F86" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 24 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top spacing", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 32 }
  ],
  "presets": [
    { "name": "DikadoIn — Mascot callout" }
  ]
}
{% endschema %}
