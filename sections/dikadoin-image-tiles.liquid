<section
  id="DikadoinTiles-{{ section.id }}"
  class="dikadoin-tiles"
  style="
    --tiles-text: {{ section.settings.text_color }};
    --tiles-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="dikadoin-tiles__header">
        <h2 class="dikadoin-tiles__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <div class="dikadoin-tiles__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="dikadoin-tiles__grid">
      {% for block in section.blocks %}
        <a
          class="dikadoin-tiles__tile dikadoin-tiles__tile--{{ block.settings.size }}"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '320, 480, 720, 960, 1200',
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'dikadoin-tiles__image'
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'dikadoin-tiles__placeholder placeholder-svg' }}
          {% endif %}

          <span class="dikadoin-tiles__overlay" style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></span>

          <span class="dikadoin-tiles__content">
            {% if block.settings.eyebrow != blank %}
              <span class="dikadoin-tiles__eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {% endif %}
            <strong class="dikadoin-tiles__title">{{ block.settings.heading | escape }}</strong>
            {% if block.settings.link_label != blank %}
              <span class="dikadoin-tiles__link">{{ block.settings.link_label | escape }} →</span>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #DikadoinTiles-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: var(--tiles-text);
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__header {
    max-width: 720px;
    margin-bottom: 24px;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1.05;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__text {
    margin-top: 10px;
    line-height: 1.6;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 220px;
    gap: 16px;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__tile {
    position: relative;
    display: block;
    min-width: 0;
    border-radius: var(--tiles-radius);
    overflow: hidden;
    text-decoration: none;
    background: #eee;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__tile--wide {
    grid-column: span 2;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__tile--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__image,
  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__tile:hover .dikadoin-tiles__image {
    transform: scale(1.025);
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,calc(var(--overlay-opacity) + .18)), rgba(0,0,0,0));
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__content {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    color: #fff;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__eyebrow {
    margin-bottom: 5px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .86;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__title {
    font-size: clamp(1.25rem, 2vw, 2rem);
    line-height: 1.05;
  }

  #DikadoinTiles-{{ section.id }} .dikadoin-tiles__link {
    margin-top: 8px;
    font-size: .92rem;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    #DikadoinTiles-{{ section.id }} .dikadoin-tiles__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 180px;
      gap: 10px;
    }

    #DikadoinTiles-{{ section.id }} .dikadoin-tiles__tile--large {
      grid-column: span 2;
      grid-row: span 2;
    }

    #DikadoinTiles-{{ section.id }} .dikadoin-tiles__tile--wide {
      grid-column: span 2;
    }

    #DikadoinTiles-{{ section.id }} .dikadoin-tiles__content {
      left: 16px;
      right: 16px;
      bottom: 15px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "DikadoIn — Image tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Explore by story." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Find a starting point for the kind of gift you want to make.</p>" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4B342D" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 20 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top spacing", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Custom Merchandise" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View collection" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "size",
          "label": "Tile size",
          "default": "standard",
          "options": [
            { "value": "standard", "label": "Standard" },
            { "value": "wide", "label": "Wide" },
            { "value": "large", "label": "Large" }
          ]
        },
        { "type": "range", "id": "overlay_opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Overlay darkness", "default": 20 }
      ]
    }
  ],
  "presets": [
    {
      "name": "DikadoIn — Image tiles",
      "blocks": [
        { "type": "tile", "settings": { "heading": "Custom Merchandise", "size": "large" } },
        { "type": "tile", "settings": { "heading": "Graduation", "size": "wide" } },
        { "type": "tile", "settings": { "heading": "Baby Gifts", "size": "standard" } },
        { "type": "tile", "settings": { "heading": "Hampers", "size": "standard" } }
      ]
    }
  ]
}
{% endschema %}
