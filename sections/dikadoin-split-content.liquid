<section
  id="DikadoinSplit-{{ section.id }}"
  class="dikadoin-split"
  style="
    --split-bg: {{ section.settings.background_color }};
    --split-text: {{ section.settings.text_color }};
    --split-accent: {{ section.settings.accent_color }};
    --split-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="page-width">
    <div class="dikadoin-split__grid{% if section.settings.image_position == 'right' %} dikadoin-split__grid--image-right{% endif %}">
      <div class="dikadoin-split__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'dikadoin-split__image'
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'dikadoin-split__placeholder placeholder-svg' }}
        {% endif %}
      </div>

      <div class="dikadoin-split__content">
        {% if section.settings.eyebrow != blank %}
          <p class="dikadoin-split__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="dikadoin-split__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="dikadoin-split__text rte">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="dikadoin-split__button"
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          >
            {{ section.settings.button_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #DikadoinSplit-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    border-radius: var(--split-radius);
    overflow: hidden;
    background: var(--split-bg);
    color: var(--split-text);
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__grid--image-right .dikadoin-split__media {
    order: 2;
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__media {
    min-height: 420px;
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__image,
  #DikadoinSplit-{{ section.id }} .dikadoin-split__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: {{ section.settings.image_fit }};
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(34px, 6vw, 72px);
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__eyebrow {
    margin: 0 0 10px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.02;
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__text {
    margin-top: 18px;
    max-width: 600px;
    line-height: 1.65;
  }

  #DikadoinSplit-{{ section.id }} .dikadoin-split__button {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    min-height: 46px;
    padding: 11px 20px;
    border-radius: 999px;
    background: var(--split-accent);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    #DikadoinSplit-{{ section.id }} .dikadoin-split__grid {
      grid-template-columns: 1fr;
    }

    #DikadoinSplit-{{ section.id }} .dikadoin-split__grid--image-right .dikadoin-split__media {
      order: 0;
    }

    #DikadoinSplit-{{ section.id }} .dikadoin-split__media,
    #DikadoinSplit-{{ section.id }} .dikadoin-split__image,
    #DikadoinSplit-{{ section.id }} .dikadoin-split__placeholder {
      min-height: 280px;
    }

    #DikadoinSplit-{{ section.id }} .dikadoin-split__content {
      padding: 30px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "DikadoIn — Split content",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made with your story" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From an idea to something you can keep." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Upload your artwork, choose your product, and turn a small idea into a meaningful keepsake.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start creating" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F1E8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4B342D" },
    { "type": "color", "id": "accent_color", "label": "Button", "default": "#D96C6C" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 24 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top spacing", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 48 }
  ],
  "presets": [
    { "name": "DikadoIn — Split content" }
  ]
}
{% endschema %}
