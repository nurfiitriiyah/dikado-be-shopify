<section
  id="DikadoinFeatures-{{ section.id }}"
  class="dikadoin-features"
  style="
    --features-text: {{ section.settings.text_color }};
    --features-card-bg: {{ section.settings.card_background }};
    --features-accent: {{ section.settings.accent_color }};
    --features-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="page-width">
    <div class="dikadoin-features__header">
      {% if section.settings.eyebrow != blank %}
        <p class="dikadoin-features__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="dikadoin-features__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="dikadoin-features__intro rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="dikadoin-features__scroller">
      <div class="dikadoin-features__grid">
        {% for block in section.blocks %}
          <article class="dikadoin-features__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="dikadoin-features__media">
                {{
                  block.settings.image
                  | image_url: width: 720
                  | image_tag:
                    loading: 'lazy',
                    widths: '240, 360, 480, 720',
                    sizes: '(min-width: 990px) 25vw, 78vw',
                    class: 'dikadoin-features__image'
                }}
              </div>
            {% elsif block.settings.icon != blank %}
              <div class="dikadoin-features__icon" aria-hidden="true">{{ block.settings.icon }}</div>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h3 class="dikadoin-features__card-title">{{ block.settings.heading | escape }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="dikadoin-features__card-text rte">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.link_label != blank %}
              <a
                class="dikadoin-features__link"
                {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
              >
                {{ block.settings.link_label | escape }} <span aria-hidden="true">→</span>
              </a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #DikadoinFeatures-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: var(--features-text);
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__header {
    max-width: 720px;
    margin-bottom: 28px;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__eyebrow {
    margin: 0 0 8px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.68;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1.05;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__intro {
    margin-top: 12px;
    line-height: 1.6;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 16px;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__card {
    display: flex;
    flex-direction: column;
    min-height: 260px;
    padding: 22px;
    border-radius: var(--features-radius);
    background: var(--features-card-bg);
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__media {
    height: 120px;
    margin-bottom: 18px;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__icon {
    margin-bottom: 18px;
    font-size: 2.4rem;
    line-height: 1;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__card-title {
    margin: 0;
    color: inherit;
    font-size: 1.25rem;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__card-text {
    margin-top: 8px;
    font-size: 0.96rem;
    line-height: 1.55;
  }

  #DikadoinFeatures-{{ section.id }} .dikadoin-features__link {
    display: inline-flex;
    gap: 7px;
    margin-top: auto;
    padding-top: 18px;
    color: var(--features-accent);
    text-decoration: none;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    #DikadoinFeatures-{{ section.id }} .dikadoin-features__scroller {
      margin-right: calc(-1 * var(--page-width-margin, 1.5rem));
      overflow-x: auto;
      scrollbar-width: none;
    }

    #DikadoinFeatures-{{ section.id }} .dikadoin-features__scroller::-webkit-scrollbar {
      display: none;
    }

    #DikadoinFeatures-{{ section.id }} .dikadoin-features__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(82vw, 320px);
      width: max-content;
      padding-right: 24px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "DikadoIn — Feature cards",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore DikadoIn" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A few ways to make it special." },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>Choose a starting point, then make it feel more like you.</p>" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F8F1E8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4B342D" },
    { "type": "color", "id": "accent_color", "label": "Link accent", "default": "#B94E5A" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Card corner radius", "default": 20 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top spacing", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 48 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image / mascot" },
        { "type": "text", "id": "icon", "label": "Emoji fallback", "default": "🎁" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Find a Gift" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Temukan sesuatu yang terasa pas untuk mereka.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DikadoIn — Feature cards",
      "blocks": [
        { "type": "feature", "settings": { "icon": "🎁", "heading": "Find a Gift", "text": "<p>Temukan sesuatu yang terasa pas untuk mereka.</p>" } },
        { "type": "feature", "settings": { "icon": "🎨", "heading": "Make It Yours", "text": "<p>Buat merchandise dengan desain dan gayamu sendiri.</p>" } },
        { "type": "feature", "settings": { "icon": "📦", "heading": "Build a Hamper", "text": "<p>Gabungkan isi favorit mereka dalam satu kado.</p>" } },
        { "type": "feature", "settings": { "icon": "💌", "heading": "Say It Better", "text": "<p>Bantu cari kata-kata untuk melengkapi kadomu.</p>" } }
      ]
    }
  ]
}
{% endschema %}
