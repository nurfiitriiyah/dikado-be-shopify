<section
  id="DikadoinMiniBanner-{{ section.id }}"
  class="dikadoin-mini-banner"
  style="
    --mini-bg: {{ section.settings.background_color }};
    --mini-text: {{ section.settings.text_color }};
    --mini-accent: {{ section.settings.accent_color }};
    --mini-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="page-width">
    <div class="dikadoin-mini-banner__box">
      <div class="dikadoin-mini-banner__content">
        {% if section.settings.eyebrow != blank %}
          <p class="dikadoin-mini-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="dikadoin-mini-banner__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="dikadoin-mini-banner__text rte">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="dikadoin-mini-banner__link"
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          >
            {{ section.settings.button_label | escape }} <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.image != blank %}
        <div class="dikadoin-mini-banner__media">
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '320, 480, 640, 900',
              sizes: '(min-width: 750px) 32vw, 70vw',
              class: 'dikadoin-mini-banner__image'
          }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #DikadoinMiniBanner-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__box {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(220px, 0.6fr);
    align-items: center;
    gap: 28px;
    min-height: 260px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: var(--mini-radius);
    background: var(--mini-bg);
    color: var(--mini-text);
    overflow: hidden;
  }

  #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__content {
    max-width: 680px;
  }

  #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__eyebrow {
    margin: 0 0 8px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1.05;
  }

  #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__text {
    margin-top: 12px;
    max-width: 620px;
    line-height: 1.6;
  }

  #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__link {
    display: inline-flex;
    gap: 8px;
    margin-top: 18px;
    color: var(--mini-accent);
    text-decoration: none;
    font-weight: 700;
  }

  #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__media {
    align-self: end;
  }

  #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__image {
    display: block;
    width: 100%;
    max-height: 250px;
    object-fit: contain;
    object-position: center bottom;
  }

  @media screen and (max-width: 749px) {
    #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__box {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 28px;
    }

    #DikadoinMiniBanner-{{ section.id }} .dikadoin-mini-banner__media {
      width: min(75%, 320px);
      justify-self: center;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "DikadoIn — Mini banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A little something" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Make it yours." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bawa ide dan gayamu sendiri jadi sesuatu yang bisa dipakai, dibawa, dan disimpan sebagai bagian dari ceritamu.</p>" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Start creating" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Mascot / product image" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4DFD8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4B342D" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B94E5A" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 24 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top spacing", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 32 }
  ],
  "presets": [
    { "name": "DikadoIn — Mini banner" }
  ]
}
{% endschema %}
