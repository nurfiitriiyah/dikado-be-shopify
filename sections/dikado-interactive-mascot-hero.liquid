{% comment %}
  DikadoIn Interactive Mascot Hero
  Lightweight replacement for a homepage video.
{% endcomment %}

{% liquid
  assign hero_id = 'DikadoHero-' | append: section.id
%}

<section
  id="{{ hero_id }}"
  class="dikado-hero{% if section.settings.full_width %} dikado-hero--full{% endif %}{% unless section.settings.show_content %} dikado-hero--no-content{% endunless %}"
  data-parallax="{{ section.settings.enable_parallax }}"
  style="
    --hero-bg: {{ section.settings.background_color }};
    --hero-height-desktop: {{ section.settings.height_desktop }}px;
    --hero-height-mobile: {{ section.settings.height_mobile }}px;
    --hero-radius: {{ section.settings.corner_radius }}px;
    --hero-bg-position: {{ section.settings.background_position }};
    --hero-overlay-opacity: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};
    --goose-size: {{ section.settings.goose_size }}%;
    --raty-size: {{ section.settings.raty_size }}%;
    --rooster-size: {{ section.settings.rooster_size }}%;
    --catfish-size: {{ section.settings.catfish_size }}%;
    --goose-x: {{ section.settings.goose_x }}%;
    --goose-y: {{ section.settings.goose_y }}%;
    --raty-x: {{ section.settings.raty_x }}%;
    --raty-y: {{ section.settings.raty_y }}%;
    --rooster-x: {{ section.settings.rooster_x }}%;
    --rooster-y: {{ section.settings.rooster_y }}%;
    --catfish-x: {{ section.settings.catfish_x }}%;
    --catfish-y: {{ section.settings.catfish_y }}%;
  "
>
  <div class="dikado-hero__shell">
    <div class="dikado-hero__background" aria-hidden="true">
      {% if section.settings.background_image != blank %}
        <picture class="dikado-hero__background-picture">
          {% if section.settings.background_image_mobile != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.background_image_mobile | image_url: width: 1200 }}">
          {% endif %}
          {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'dikado-hero__background-image', widths: '900, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
        </picture>
      {% endif %}

      {% if section.settings.show_background_decor %}
        <span class="dikado-hero__blob dikado-hero__blob--one"></span>
        <span class="dikado-hero__blob dikado-hero__blob--two"></span>
      {% endif %}

      {% if section.settings.background_overlay_opacity > 0 %}
        <span class="dikado-hero__background-overlay"></span>
      {% endif %}
    </div>

    {% if section.settings.show_content %}
      <div class="dikado-hero__content">
        {% if section.settings.eyebrow != blank %}
          <div class="dikado-hero__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="dikado-hero__heading">{{ section.settings.heading | escape }}</h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="dikado-hero__description">{{ section.settings.description | escape }}</p>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a class="dikado-hero__button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
            {{ section.settings.button_label | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="dikado-hero__stage" aria-label="DikadoIn mascot scene">
      {% if section.settings.goose_image != blank %}
        <div class="dikado-hero__layer dikado-hero__layer--goose" data-parallax-strength="3">
          <div class="dikado-hero__motion dikado-hero__motion--goose{% unless section.settings.enable_mascot_animation %} is-static{% endunless %}">
            {{ section.settings.goose_image | image_url: width: 1000 | image_tag: class: 'dikado-hero__image', widths: '240, 360, 480, 640, 800, 1000', sizes: '(min-width: 990px) 26vw, 42vw', loading: 'eager', alt: 'Goose mascot holding a ribbon' }}
          </div>
        </div>
      {% endif %}

      {% if section.settings.raty_image != blank %}
        <div class="dikado-hero__layer dikado-hero__layer--raty" data-parallax-strength="5">
          <div class="dikado-hero__motion dikado-hero__motion--raty{% unless section.settings.enable_mascot_animation %} is-static{% endunless %}">
            {{ section.settings.raty_image | image_url: width: 1200 | image_tag: class: 'dikado-hero__image', widths: '320, 480, 640, 800, 1000, 1200', sizes: '(min-width: 990px) 34vw, 56vw', loading: 'eager', fetchpriority: 'high', alt: 'Raty mascot pushing a shopping cart filled with gifts' }}
          </div>
        </div>
      {% endif %}

      {% if section.settings.rooster_image != blank %}
        <div class="dikado-hero__layer dikado-hero__layer--rooster" data-parallax-strength="4">
          <div class="dikado-hero__motion dikado-hero__motion--rooster{% unless section.settings.enable_mascot_animation %} is-static{% endunless %}">
            {{ section.settings.rooster_image | image_url: width: 1000 | image_tag: class: 'dikado-hero__image', widths: '240, 360, 480, 640, 800, 1000', sizes: '(min-width: 990px) 25vw, 42vw', loading: 'eager', alt: 'Rooster mascot carrying a gift box' }}
          </div>
        </div>
      {% endif %}

      {% if section.settings.gift_box_image != blank %}
        <div class="dikado-hero__layer dikado-hero__layer--gift" data-parallax-strength="2" aria-hidden="true">
          <div class="dikado-hero__gift-motion">
            {{ section.settings.gift_box_image | image_url: width: 700 | image_tag: class: 'dikado-hero__image', widths: '220, 320, 480, 640, 700', sizes: '(min-width: 990px) 20vw, 35vw', loading: 'lazy', alt: '' }}
          </div>
        </div>
      {% endif %}

      {% if section.settings.catfish_image != blank %}
        <div class="dikado-hero__layer dikado-hero__layer--catfish" data-parallax-strength="2">
          <div class="dikado-hero__catfish-window">
            <div class="dikado-hero__motion dikado-hero__motion--catfish{% unless section.settings.enable_mascot_animation %} is-static{% endunless %}">
              {{ section.settings.catfish_image | image_url: width: 900 | image_tag: class: 'dikado-hero__image', widths: '220, 320, 480, 640, 800, 900', sizes: '(min-width: 990px) 22vw, 38vw', loading: 'eager', alt: 'Catfish mascot peeking playfully' }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if section.settings.sparkle_1 != blank %}
        <div class="dikado-hero__decor dikado-hero__decor--sparkle-one{% unless section.settings.enable_decor_animation %} is-static{% endunless %}" data-parallax-strength="8" aria-hidden="true">
          {{ section.settings.sparkle_1 | image_url: width: 180 | image_tag: class: 'dikado-hero__decor-image', widths: '60, 90, 120, 180', sizes: '90px', loading: 'lazy', alt: '' }}
        </div>
      {% endif %}

      {% if section.settings.sparkle_2 != blank %}
        <div class="dikado-hero__decor dikado-hero__decor--sparkle-two{% unless section.settings.enable_decor_animation %} is-static{% endunless %}" data-parallax-strength="7" aria-hidden="true">
          {{ section.settings.sparkle_2 | image_url: width: 180 | image_tag: class: 'dikado-hero__decor-image', widths: '60, 90, 120, 180', sizes: '80px', loading: 'lazy', alt: '' }}
        </div>
      {% endif %}

      {% if section.settings.heart_image != blank %}
        <div class="dikado-hero__decor dikado-hero__decor--heart{% unless section.settings.enable_decor_animation %} is-static{% endunless %}" data-parallax-strength="6" aria-hidden="true">
          {{ section.settings.heart_image | image_url: width: 180 | image_tag: class: 'dikado-hero__decor-image', widths: '60, 90, 120, 180', sizes: '80px', loading: 'lazy', alt: '' }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #{{ hero_id }} { width: 100%; padding: 12px 16px 24px; box-sizing: border-box; }
  #{{ hero_id }} .dikado-hero__shell { position: relative; width: min(100%, 1440px); min-height: var(--hero-height-desktop); margin: 0 auto; overflow: hidden; isolation: isolate; border-radius: var(--hero-radius); background: var(--hero-bg); }
  #{{ hero_id }}.dikado-hero--full { padding-left: 0; padding-right: 0; }
  #{{ hero_id }}.dikado-hero--full .dikado-hero__shell { width: 100%; max-width: none; border-radius: 0; }
  #{{ hero_id }} .dikado-hero__background, #{{ hero_id }} .dikado-hero__stage { position: absolute; inset: 0; }
  #{{ hero_id }} .dikado-hero__background { z-index: 0; pointer-events: none; }
  #{{ hero_id }} .dikado-hero__background-picture, #{{ hero_id }} .dikado-hero__background-image { position: absolute; inset: 0; width: 100%; height: 100%; }
  #{{ hero_id }} .dikado-hero__background-picture { display: block; }
  #{{ hero_id }} .dikado-hero__background-image { object-fit: cover; object-position: var(--hero-bg-position); }
  #{{ hero_id }} .dikado-hero__background-overlay { position: absolute; inset: 0; z-index: 1; background: var(--hero-bg); opacity: var(--hero-overlay-opacity); }
  #{{ hero_id }} .dikado-hero__blob { position: absolute; z-index: 2; display: block; border-radius: 999px; opacity: .45; pointer-events: none; }
  #{{ hero_id }} .dikado-hero__blob--one { width: 340px; height: 340px; right: 8%; top: -160px; background: rgba(255,218,191,.52); }
  #{{ hero_id }} .dikado-hero__blob--two { width: 260px; height: 260px; left: 36%; bottom: -150px; background: rgba(228,214,255,.38); }

  #{{ hero_id }} .dikado-hero__content { position: relative; z-index: 20; width: min(34%, 430px); padding: clamp(44px,6vw,86px) 0 0 clamp(28px,5vw,76px); }
  #{{ hero_id }} .dikado-hero__eyebrow { margin: 0 0 10px; font-size: .82rem; line-height: 1.2; letter-spacing: .08em; text-transform: uppercase; opacity: .65; }
  #{{ hero_id }} .dikado-hero__heading { max-width: 10ch; margin: 0; font: inherit; font-size: clamp(2.2rem,4.2vw,4.8rem); font-weight: 500; line-height: .98; letter-spacing: -.045em; color: inherit; }
  #{{ hero_id }} .dikado-hero__description { max-width: 34ch; margin: 18px 0 0; font-size: clamp(.95rem,1.15vw,1.08rem); line-height: 1.55; opacity: .74; }
  #{{ hero_id }} .dikado-hero__button { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; margin-top: 24px; padding: 0 22px; border-radius: 12px; background: #1d1d1d; color: #fff; text-decoration: none; font-size: .94rem; line-height: 1; transition: transform 180ms ease, opacity 180ms ease; }
  #{{ hero_id }} .dikado-hero__button:hover { transform: translateY(-2px); }
  #{{ hero_id }} .dikado-hero__button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  #{{ hero_id }} .dikado-hero__stage { z-index: 10; pointer-events: none; }
  #{{ hero_id }} .dikado-hero__layer, #{{ hero_id }} .dikado-hero__decor { position: absolute; transform: translate3d(var(--px,0px),var(--py,0px),0); will-change: transform; }
  #{{ hero_id }} .dikado-hero__motion, #{{ hero_id }} .dikado-hero__gift-motion { width: 100%; height: 100%; }
  #{{ hero_id }} .dikado-hero__image, #{{ hero_id }} .dikado-hero__decor-image { display: block; width: 100%; height: auto; }

  #{{ hero_id }} .dikado-hero__layer--goose { left: var(--goose-x); top: var(--goose-y); width: var(--goose-size); z-index: 5; }
  #{{ hero_id }} .dikado-hero__layer--raty { left: var(--raty-x); top: var(--raty-y); width: var(--raty-size); z-index: 8; }
  #{{ hero_id }} .dikado-hero__layer--rooster { left: var(--rooster-x); top: var(--rooster-y); width: var(--rooster-size); z-index: 7; }
  #{{ hero_id }} .dikado-hero__layer--gift { left: 52%; bottom: 2%; width: 20%; z-index: 3; pointer-events: auto; }
  #{{ hero_id }} .dikado-hero__layer--catfish { left: var(--catfish-x); top: var(--catfish-y); width: var(--catfish-size); z-index: 9; }
  #{{ hero_id }} .dikado-hero__catfish-window { overflow: hidden; padding-top: 18px; }

  #{{ hero_id }} .dikado-hero__decor { z-index: 12; pointer-events: none; }
  #{{ hero_id }} .dikado-hero__decor--sparkle-one { width: clamp(34px,4vw,68px); left: 40%; top: 16%; animation: dikado-sparkle-one 3.1s ease-in-out infinite; }
  #{{ hero_id }} .dikado-hero__decor--sparkle-two { width: clamp(28px,3.3vw,56px); right: 8%; top: 18%; animation: dikado-sparkle-two 3.8s ease-in-out .45s infinite; }
  #{{ hero_id }} .dikado-hero__decor--heart { width: clamp(34px,3.8vw,64px); left: 54%; bottom: 9%; animation: dikado-heart 4.4s ease-in-out .8s infinite; }

  #{{ hero_id }} .dikado-hero__motion--goose { animation: dikado-goose 4.6s ease-in-out infinite; }
  #{{ hero_id }} .dikado-hero__motion--raty { animation: dikado-raty 5.2s ease-in-out .35s infinite; transform-origin: 50% 85%; }
  #{{ hero_id }} .dikado-hero__motion--rooster { animation: dikado-rooster 4.1s ease-in-out .65s infinite; }
  #{{ hero_id }} .dikado-hero__motion--catfish { animation: dikado-catfish-peek 7.5s ease-in-out 1.1s infinite; }
  #{{ hero_id }} .dikado-hero__gift-motion { transition: transform 320ms ease; transform-origin: center bottom; }
  #{{ hero_id }} .dikado-hero__layer--gift:hover .dikado-hero__gift-motion { transform: rotate(-1deg) scale(1.015); }
  #{{ hero_id }} .is-static { animation: none !important; }

  @keyframes dikado-goose { 0%,100% { transform: translate3d(0,0,0) rotate(-.25deg); } 50% { transform: translate3d(0,-5px,0) rotate(.25deg); } }
  @keyframes dikado-raty { 0%,100% { transform: translate3d(-3px,0,0) rotate(-.45deg); } 50% { transform: translate3d(3px,-2px,0) rotate(.45deg); } }
  @keyframes dikado-rooster { 0%,100% { transform: translate3d(0,0,0); } 50% { transform: translate3d(0,-6px,0); } }
  @keyframes dikado-catfish-peek { 0%,100% { transform: translate3d(0,28px,0); } 14% { transform: translate3d(0,2px,0); } 62% { transform: translate3d(0,2px,0); } 80% { transform: translate3d(0,28px,0); } }
  @keyframes dikado-sparkle-one { 0%,100% { transform: scale(.86) rotate(0deg); opacity: .65; } 50% { transform: scale(1.05) rotate(8deg); opacity: 1; } }
  @keyframes dikado-sparkle-two { 0%,100% { transform: scale(.9) rotate(4deg); opacity: .55; } 50% { transform: scale(1.08) rotate(-7deg); opacity: 1; } }
  @keyframes dikado-heart { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }

  @media screen and (max-width: 989px) {
    #{{ hero_id }} { padding: 8px 12px 20px; }
    #{{ hero_id }} .dikado-hero__shell { min-height: var(--hero-height-mobile); border-radius: min(var(--hero-radius),20px); }
    #{{ hero_id }} .dikado-hero__content { width: auto; padding: 28px 24px 0; text-align: center; }
    #{{ hero_id }} .dikado-hero__heading { max-width: 13ch; margin-left: auto; margin-right: auto; font-size: clamp(2rem,10vw,3.6rem); }
    #{{ hero_id }} .dikado-hero__description { max-width: 32ch; margin-left: auto; margin-right: auto; }
    #{{ hero_id }} .dikado-hero__button { margin-top: 18px; }
    #{{ hero_id }} .dikado-hero__layer--raty { width: 56%; left: 25%; top: 31%; }
    #{{ hero_id }} .dikado-hero__layer--goose { width: 33%; left: 4%; top: 59%; }
    #{{ hero_id }} .dikado-hero__layer--rooster { width: 33%; left: 64%; top: 58%; }
    #{{ hero_id }} .dikado-hero__layer--catfish { width: 27%; left: 38%; top: 76%; }
    #{{ hero_id }} .dikado-hero__layer--gift { width: 25%; left: 38%; bottom: 3%; }
    #{{ hero_id }} .dikado-hero__decor--sparkle-one { left: 12%; top: 31%; }
    #{{ hero_id }} .dikado-hero__decor--sparkle-two { right: 9%; top: 36%; }
    #{{ hero_id }} .dikado-hero__decor--heart { left: 76%; bottom: 8%; }
  }

  @media screen and (max-width: 560px) {
    #{{ hero_id }} .dikado-hero__description { display: none; }
    #{{ hero_id }} .dikado-hero__button { min-height: 42px; padding-left: 18px; padding-right: 18px; }
    #{{ hero_id }} .dikado-hero__decor--sparkle-two { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ hero_id }} .dikado-hero__motion, #{{ hero_id }} .dikado-hero__decor { animation: none !important; }
    #{{ hero_id }} .dikado-hero__layer, #{{ hero_id }} .dikado-hero__decor { transform: none !important; will-change: auto; }
    #{{ hero_id }} .dikado-hero__motion--catfish { transform: translate3d(0,2px,0) !important; }
  }
{% endstyle %}

<script>
  (() => {
    const section = document.getElementById('{{ hero_id }}');
    if (!section || section.dataset.dikadoInitialized === 'true') return;
    section.dataset.dikadoInitialized = 'true';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(pointer: fine)');
    const parallaxEnabled = section.dataset.parallax === 'true';
    if (!parallaxEnabled || reducedMotion.matches || !finePointer.matches) return;

    const layers = section.querySelectorAll('[data-parallax-strength]');
    let frame = null;
    let bounds = null;
    let nextX = 0;
    let nextY = 0;

    const update = () => {
      layers.forEach((layer) => {
        const strength = Number(layer.dataset.parallaxStrength || 0);
        layer.style.setProperty('--px', `${nextX * strength}px`);
        layer.style.setProperty('--py', `${nextY * strength}px`);
      });
      frame = null;
    };

    section.addEventListener('pointerenter', () => { bounds = section.getBoundingClientRect(); });
    section.addEventListener('pointermove', (event) => {
      bounds = bounds || section.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width;
      const y = (event.clientY - bounds.top) / bounds.height;
      nextX = (x - .5) * 2;
      nextY = (y - .5) * 2;
      if (!frame) frame = requestAnimationFrame(update);
    });
    section.addEventListener('pointerleave', () => {
      bounds = null;
      nextX = 0;
      nextY = 0;
      if (!frame) frame = requestAnimationFrame(update);
    });
  })();
</script>

{% schema %}
{
  "name": "DikadoIn mascot hero",
  "tag": "section",
  "class": "section-dikado-mascot-hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_content", "label": "Show text content", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DikadoIn" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make It Personal" },
    { "type": "text", "id": "description", "label": "Short description" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Creating" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Mascot images" },
    { "type": "image_picker", "id": "goose_image", "label": "Goose + ribbon" },
    { "type": "image_picker", "id": "raty_image", "label": "Raty + shopping cart" },
    { "type": "image_picker", "id": "rooster_image", "label": "Rooster + gift box" },
    { "type": "image_picker", "id": "catfish_image", "label": "Catfish peek" },
    { "type": "image_picker", "id": "gift_box_image", "label": "Optional separate center gift box" },

    { "type": "header", "content": "Decorations" },
    { "type": "image_picker", "id": "sparkle_1", "label": "Sparkle 1" },
    { "type": "image_picker", "id": "sparkle_2", "label": "Sparkle 2" },
    { "type": "image_picker", "id": "heart_image", "label": "Heart" },

    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Mobile background image (optional)" },
    { "type": "select", "id": "background_position", "label": "Background image position", "default": "center center", "options": [
      { "value": "left center", "label": "Left" },
      { "value": "center center", "label": "Center" },
      { "value": "right center", "label": "Right" }
    ] },
    { "type": "range", "id": "background_overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Background color overlay", "default": 0 },
    { "type": "checkbox", "id": "show_background_decor", "label": "Show pastel background blobs", "default": false },

    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background / fallback color", "default": "#FFF8EE" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "range", "id": "height_desktop", "min": 520, "max": 820, "step": 20, "unit": "px", "label": "Desktop height", "default": 660 },
    { "type": "range", "id": "height_mobile", "min": 480, "max": 760, "step": 20, "unit": "px", "label": "Mobile height", "default": 620 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 20 },

    { "type": "header", "content": "Desktop mascot sizes" },
    { "type": "range", "id": "goose_size", "min": 12, "max": 35, "step": 1, "unit": "%", "label": "Goose size", "default": 22 },
    { "type": "range", "id": "raty_size", "min": 18, "max": 42, "step": 1, "unit": "%", "label": "Raty size", "default": 31 },
    { "type": "range", "id": "rooster_size", "min": 12, "max": 35, "step": 1, "unit": "%", "label": "Rooster size", "default": 22 },
    { "type": "range", "id": "catfish_size", "min": 10, "max": 30, "step": 1, "unit": "%", "label": "Catfish size", "default": 18 },

    { "type": "header", "content": "Desktop positions" },
    { "type": "range", "id": "goose_x", "min": 0, "max": 85, "step": 1, "unit": "%", "label": "Goose horizontal position", "default": 30 },
    { "type": "range", "id": "goose_y", "min": 0, "max": 80, "step": 1, "unit": "%", "label": "Goose vertical position", "default": 47 },
    { "type": "range", "id": "raty_x", "min": 0, "max": 75, "step": 1, "unit": "%", "label": "Raty horizontal position", "default": 45 },
    { "type": "range", "id": "raty_y", "min": 0, "max": 65, "step": 1, "unit": "%", "label": "Raty vertical position", "default": 12 },
    { "type": "range", "id": "rooster_x", "min": 0, "max": 85, "step": 1, "unit": "%", "label": "Rooster horizontal position", "default": 75 },
    { "type": "range", "id": "rooster_y", "min": 0, "max": 80, "step": 1, "unit": "%", "label": "Rooster vertical position", "default": 43 },
    { "type": "range", "id": "catfish_x", "min": 0, "max": 85, "step": 1, "unit": "%", "label": "Catfish horizontal position", "default": 56 },
    { "type": "range", "id": "catfish_y", "min": 20, "max": 90, "step": 1, "unit": "%", "label": "Catfish vertical position", "default": 67 },

