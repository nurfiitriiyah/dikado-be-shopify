{{ 'dikado-precheckout.css' | asset_url | stylesheet_tag }}
{{ 'full-screen-loader.css' | asset_url | stylesheet_tag }}
<script src="{{ 'full-screen-loader.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'dikado-precheckout.js' | asset_url }}" defer="defer"></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--page-width color-{{ section.settings.color_scheme }} dikado-checkout-section">
  {% if customer %}
    {% assign precheckout_loader_id = 'DikadoPrecheckoutLoader-' | append: section.id %}
    {% render 'full-screen-loader',
      id: precheckout_loader_id,
      color_scheme: section.settings.color_scheme,
      loading_text: 'Menyiapkan pengiriman…',
      loading_description: 'Kami sedang memuat alamat dan pilihan pengiriman Anda.'
    %}
  {% endif %}
  <div id="DikadoPrecheckoutContent-{{ section.id }}"{% if customer %} hidden{% endif %}>
    <div class="dikado-checkout-heading">
      <h1>{{ section.settings.heading | escape }}</h1>
    </div>
  {% if customer %}
    <dikado-precheckout
      data-api-base="/apps/dikado-address"
      data-origin-district-id="1330"
      data-couriers="{{ section.settings.couriers | escape }}"
      data-checkout-url="{{ routes.root_url }}checkout"
      data-storefront-api-url="/api/2026-07/graphql.json"
      data-loader-id="{{ precheckout_loader_id }}"
      data-content-id="DikadoPrecheckoutContent-{{ section.id }}"
    >
      <div class="dikado-checkout-grid">
        <div class="dikado-checkout-main">
          <section class="dikado-panel" aria-labelledby="DikadoAddressHeading">
            <div class="dikado-panel__heading"><div><span class="dikado-step">1</span><h2 id="DikadoAddressHeading">Alamat pengiriman</h2></div><button class="button button-secondary" type="button" data-add-address>Tambah alamat baru</button></div>
            <div data-address-status role="status" aria-live="polite">Memuat alamat…</div>
            <div class="dikado-address-list" data-address-list></div>
          </section>
          <section class="dikado-panel" aria-labelledby="DikadoShippingHeading">
            <div class="dikado-panel__heading"><div><span class="dikado-step">2</span><h2 id="DikadoShippingHeading">Estimasi ongkir</h2></div></div>
            <div data-shipping-status role="status" aria-live="polite"></div>
            <div class="dikado-shipping-list" data-shipping-list></div>
          </section>
        </div>
        <aside class="dikado-panel dikado-shipping-summary" aria-labelledby="DikadoShippingSummaryHeading">
          <h2 id="DikadoShippingSummaryHeading">Ongkir terpilih</h2>
          <p class="dikado-shipping-summary__empty" data-selected-shipping-empty>Pilih alamat untuk melihat layanan pengiriman.</p>
          <div class="dikado-shipping-summary__selection" data-selected-shipping hidden>
            <strong data-selected-shipping-name></strong>
            <p class="dikado-muted" data-selected-shipping-etd hidden></p>
            <p class="dikado-shipping-summary__price" data-shipping-price></p>
          </div>
          <p class="dikado-checkout-error" data-checkout-error role="alert" hidden></p>
          <button class="button dikado-continue" type="button" data-continue disabled>Lanjut ke pembayaran</button>
          <a class="dikado-cart-link" href="{{ routes.cart_url }}">Kembali ke cart</a>
        </aside>
      </div>

      <dialog class="dikado-address-modal" data-address-modal aria-labelledby="DikadoModalTitle">
        <form method="dialog" class="dikado-address-modal__shell" data-address-form>
          <div class="dikado-address-modal__heading"><h2 id="DikadoModalTitle" data-modal-title>Tambah alamat</h2><button type="button" class="button-unstyled dikado-modal-close" data-modal-close aria-label="Tutup">×</button></div>
          <p class="dikado-form-error" data-form-error role="alert" hidden></p>
          <div class="dikado-form-grid">
            <label>Label alamat<input name="label" maxlength="50" required></label>
            <label>Nama penerima<input name="recipient_name" maxlength="120" required></label>
            <label>Nomor telepon<input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" pattern="[+0-9() .-]{8,30}" placeholder="Contoh: 0822 4624 1501" required></label>
            <label class="dikado-form-grid__wide">Alamat lengkap<textarea name="address_line" maxlength="500" rows="3" required></textarea></label>
            <label class="dikado-form-grid__wide">Patokan (opsional)<input name="direction" maxlength="250"></label>
            <label>Provinsi<select name="province_id" required><option value="">Pilih provinsi</option></select></label>
            <label>Kota/Kabupaten<select name="city_id" required disabled><option value="">Pilih kota/kabupaten</option></select></label>
            <label>Kecamatan<select name="district_id" required disabled><option value="">Pilih kecamatan</option></select></label>
            <label>Kelurahan<select name="subdistrict_id" required disabled><option value="">Pilih kelurahan</option></select></label>
            <label class="dikado-checkbox dikado-form-grid__wide"><input type="checkbox" name="is_default"> Jadikan alamat utama</label>
          </div>
          <div class="dikado-modal-actions"><button class="button button-secondary" type="button" data-modal-close>Batal</button><button class="button" type="submit" data-save-address>Simpan alamat</button></div>
        </form>
      </dialog>
    </dikado-precheckout>
  {% else %}
    <div class="dikado-panel dikado-login-state"><h2>Masuk untuk melanjutkan</h2><p>Alamat tersimpan hanya tersedia untuk pelanggan yang sudah masuk.</p><a class="button" href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}">Masuk</a></div>
  {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Dikado pre-checkout",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Pilih Pengiriman"},
    {"type":"text","id":"couriers","label":"RajaOngkir couriers","default":"jne:sicepat"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ],
  "presets": [{"name":"Dikado pre-checkout"}]
}
{% endschema %}
