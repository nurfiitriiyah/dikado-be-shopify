    }

    #bp-builder-{{ section.id }} .bp-builder-empty-emoji {
      display: block;
      font-size: 32px;
      margin-bottom: 10px;
    }

    /* CANVAS */
    #bp-builder-{{ section.id }} .bp-builder-canvas-panel {
      min-width: 0;
      padding: 18px;
      background: color-mix(in srgb, var(--bp-canvas) 88%, white);
    }

    #bp-builder-{{ section.id }} .bp-builder-canvas-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      min-height: 44px;
      margin-bottom: 12px;
    }

    #bp-builder-{{ section.id }} .bp-builder-canvas-hint {
      color: var(--bp-muted);
      font-size: 12px;
    }

    #bp-builder-{{ section.id }} .bp-builder-toolbar-actions {
      display: flex;
      gap: 6px;
    }

    #bp-builder-{{ section.id }} .bp-builder-tool-btn {
      min-height: 36px;
      padding-inline: 11px;
      font-size: 12px;
      background: rgba(255,255,255,0.78);
    }

    #bp-builder-{{ section.id }} .bp-builder-tool-btn:disabled {
      opacity: 0.34;
      cursor: not-allowed;
    }

    #bp-builder-{{ section.id }} .bp-builder-canvas-wrap {
      display: grid;
      place-items: center;
      min-height: 560px;
    }

    #bp-builder-{{ section.id }} .bp-builder-canvas {
      position: relative;
      width: min(100%, 590px);
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border: 1px solid var(--bp-border);
      border-radius: 24px;
      background-color: #fff;
      background-image: radial-gradient(circle, rgba(68, 58, 95, 0.10) 1.25px, transparent 1.25px);
      background-size: 22px 22px;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.65), var(--bp-shadow-soft);
      touch-action: none;
      user-select: none;
    }

    #bp-builder-{{ section.id }} .bp-builder-base-character {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 82%;
      height: 82%;
      object-fit: contain;
      transform: translate(-50%, -50%);
      user-select: none;
      pointer-events: none;
      -webkit-user-drag: none;
    }

    #bp-builder-{{ section.id }} .bp-builder-sticker-layer {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    #bp-builder-{{ section.id }} .bp-builder-sticker {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 26%;
      aspect-ratio: 1 / 1;
      display: grid;
      place-items: center;
      transform-origin: center;
      pointer-events: auto;
      touch-action: none;
      cursor: grab;
    }

    #bp-builder-{{ section.id }} .bp-builder-sticker:active {
      cursor: grabbing;
    }

    #bp-builder-{{ section.id }} .bp-builder-sticker img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      pointer-events: none;
      user-select: none;
      -webkit-user-drag: none;
      filter: drop-shadow(0 4px 3px rgba(30, 24, 45, 0.05));
    }

    #bp-builder-{{ section.id }} .bp-builder-sticker-outline {
      position: absolute;
      inset: -6px;
      border: 1.5px dashed var(--bp-accent);
      border-radius: 10px;
      opacity: 0;
      pointer-events: none;
    }

    #bp-builder-{{ section.id }} .bp-builder-sticker.is-selected .bp-builder-sticker-outline {
      opacity: 1;
    }

    #bp-builder-{{ section.id }} .bp-builder-sticker-control {
      position: absolute;
      touch-action: none;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      display: grid;
      place-items: center;
      color: white;
      background: var(--bp-accent);
      box-shadow: 0 5px 15px rgba(30, 24, 45, 0.18);
      opacity: 0;
      pointer-events: none;
      cursor: pointer;
      font-size: 14px;
      font-weight: 900;
    }

    #bp-builder-{{ section.id }} .bp-builder-sticker.is-selected .bp-builder-sticker-control {
      opacity: 1;
      pointer-events: auto;
    }

    #bp-builder-{{ section.id }} .bp-builder-delete-handle {
      top: -18px;
      left: -18px;
      background: #ef5d6f;
    }

    #bp-builder-{{ section.id }} .bp-builder-resize-handle {
      right: -18px;
      bottom: -18px;
      cursor: nwse-resize;
    }

    #bp-builder-{{ section.id }} .bp-builder-rotate-handle {
      right: -18px;
      top: -18px;
      cursor: grab;
    }

    #bp-builder-{{ section.id }} .bp-builder-speech-bubble {
      position: absolute;
      z-index: 200;
      left: 60%;
      top: 14%;
      max-width: 170px;
      padding: 11px 14px;
      border-radius: 16px 16px 16px 5px;
      background: white;
      color: var(--bp-text);
      font-size: 13px;
      font-weight: 800;
      line-height: 1.25;
      box-shadow: 0 10px 28px rgba(50,43,76,0.14);
      pointer-events: none;
      animation: bp-builder-bubble-pop-{{ section.id }} 360ms cubic-bezier(.2,.9,.25,1.2) both;
    }

    #bp-builder-{{ section.id }} .bp-builder-speech-bubble::after {
      content: "";
      position: absolute;
      left: 10px;
      bottom: -8px;
      border-style: solid;
      border-width: 9px 9px 0 0;
      border-color: white transparent transparent transparent;
    }

    @keyframes bp-builder-bubble-pop-{{ section.id }} {
      from { opacity: 0; transform: translateY(8px) scale(0.88); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    #bp-builder-{{ section.id }} .bp-builder-mobile-help {
      display: none;
      color: var(--bp-muted);
      font-size: 12px;
      line-height: 1.5;
      margin: 11px 0 0;
      text-align: center;
    }

    #bp-builder-{{ section.id }} .bp-builder-mobile-save-wrap {
      display: none;
    }

    #bp-builder-{{ section.id }} .bp-builder-primary-btn--full {
      width: 100%;
    }

    @media (max-width: 980px) {
      #bp-builder-{{ section.id }} .bp-builder-workspace {
        grid-template-columns: 132px 260px minmax(380px, 1fr);
        overflow-x: auto;
      }

      #bp-builder-{{ section.id }} .bp-builder-canvas-wrap {
        min-height: 520px;
      }
    }

    @media (max-width: 760px) {
      #bp-builder-{{ section.id }} {
        padding: 28px 12px 44px;
      }

      #bp-builder-{{ section.id }} .bp-builder-character-grid,
      #bp-builder-{{ section.id }} .bp-builder-pose-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      #bp-builder-{{ section.id }} .bp-builder-topbar {
        grid-template-columns: auto 1fr auto;
        gap: 9px;
      }

      #bp-builder-{{ section.id }} .bp-builder-topbar .bp-builder-eyebrow {
        display: none;
      }

      #bp-builder-{{ section.id }} .bp-builder-title--compact {
        font-size: 22px;
      }

      #bp-builder-{{ section.id }} .bp-builder-back-btn {
        min-height: 39px;
        padding-inline: 11px;
        font-size: 13px;
      }

      #bp-builder-{{ section.id }} .bp-builder-save-btn {
        display: none;
      }

      #bp-builder-{{ section.id }} .bp-builder-topbar--builder {
        grid-template-columns: auto 1fr;
      }

      #bp-builder-{{ section.id }} .bp-builder-pose-summary {
        margin-bottom: 12px;
      }

      #bp-builder-{{ section.id }} .bp-builder-workspace {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: visible;
        border-radius: 22px;
      }

      #bp-builder-{{ section.id }} .bp-builder-canvas-panel {
        order: 1;
        padding: 12px;
        border-bottom: 1px solid var(--bp-border);
      }

      #bp-builder-{{ section.id }} .bp-builder-category-panel {
        order: 2;
