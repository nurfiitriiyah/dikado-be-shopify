{% comment %}
  BP Sticker Builder — NEW independent section
  ------------------------------------------------------------
  Expected Shopify Metaobject definitions / type handles:
  - character
      fields: name, thumbnail
  - character_pose
      fields: name, character (metaobject reference -> character),
              base_image, thumbnail
  - character_item
      fields: name, category, thumbnail
  - character_item_asset
      fields: item (metaobject reference -> character_item),
              pose (metaobject reference -> character_pose),
              image

  IMPORTANT:
  This section is intentionally isolated from any existing turnaround builder.
  All selectors are scoped under #bp-builder-{{ section.id }} and use bp-builder-* classes.
{% endcomment %}

<section
  id="bp-builder-{{ section.id }}"
  class="bp-builder-section"
  style="
    --bp-accent: {{ section.settings.accent_color }};
    --bp-accent-soft: {{ section.settings.accent_soft_color }};
    --bp-surface: {{ section.settings.surface_color }};
    --bp-canvas: {{ section.settings.canvas_color }};
    --bp-text: {{ section.settings.text_color }};
  "
>
  <div class="bp-builder-shell">
    <!-- STEP 1: CHARACTER -->
    <div class="bp-builder-view is-active" data-bp-view="character">
      <div class="bp-builder-intro">
        <p class="bp-builder-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="bp-builder-title">{{ section.settings.choose_title }}</h2>
        <p class="bp-builder-subtitle">{{ section.settings.choose_subtitle }}</p>
      </div>

      <div class="bp-builder-character-grid" data-bp-character-grid></div>

      <div class="bp-builder-step-actions">
        <button
          class="bp-builder-primary-btn"
          type="button"
          data-bp-continue-character
          disabled
        >
          Choose a Buddy first
        </button>
      </div>
    </div>

    <!-- STEP 2: POSE -->
    <div class="bp-builder-view" data-bp-view="pose" hidden>
      <div class="bp-builder-topbar">
        <button class="bp-builder-back-btn" type="button" data-bp-back-to-character>
          <span aria-hidden="true">←</span>
          Back
        </button>
        <div class="bp-builder-topbar-copy">
          <p class="bp-builder-eyebrow">Step 2</p>
          <h2 class="bp-builder-title bp-builder-title--compact" data-bp-pose-title>Choose a Pose</h2>
        </div>
        <span class="bp-builder-topbar-spacer" aria-hidden="true"></span>
      </div>

      <p class="bp-builder-subtitle bp-builder-subtitle--center">
        Pick the pose you want to dress up.
      </p>

      <div class="bp-builder-pose-grid" data-bp-pose-grid></div>

      <div class="bp-builder-step-actions">
        <button
          class="bp-builder-primary-btn"
          type="button"
          data-bp-start-dressing
          disabled
        >
          Choose a Pose first
        </button>
      </div>
    </div>

    <!-- STEP 3: CUSTOMIZE -->
    <div class="bp-builder-view" data-bp-view="builder" hidden>
      <div class="bp-builder-topbar bp-builder-topbar--builder">
        <button class="bp-builder-back-btn" type="button" data-bp-back-to-pose>
          <span aria-hidden="true">←</span>
          Back
        </button>

        <div class="bp-builder-topbar-copy">
          <p class="bp-builder-eyebrow">Dress-up mode</p>
          <h2 class="bp-builder-title bp-builder-title--compact" data-bp-builder-title>
            Customize your Buddy
          </h2>
        </div>

        <button class="bp-builder-save-btn" type="button" data-bp-save>
          Save Buddy
        </button>
      </div>

      <div class="bp-builder-pose-summary">
        <div class="bp-builder-pose-summary-copy">
          <span class="bp-builder-pose-summary-label">Current pose</span>
          <strong data-bp-current-pose>—</strong>
        </div>
        <button class="bp-builder-link-btn" type="button" data-bp-change-pose>
          Change pose
        </button>
      </div>

      <div class="bp-builder-workspace">
        <!-- LEFT: CATEGORY -->
        <aside class="bp-builder-category-panel" aria-label="Sticker categories">
          <p class="bp-builder-panel-label">Categories</p>
          <div class="bp-builder-category-list" data-bp-category-list></div>
        </aside>

        <!-- CENTER: ITEM LIBRARY -->
        <section class="bp-builder-library-panel">
          <div class="bp-builder-panel-heading">
            <div>
              <p class="bp-builder-panel-label">Sticker library</p>
              <h3 class="bp-builder-panel-title" data-bp-library-title>Outfit</h3>
            </div>
            <span class="bp-builder-item-count" data-bp-item-count>0 items</span>
          </div>

          <div class="bp-builder-item-grid" data-bp-item-grid></div>

          <div class="bp-builder-empty-state" data-bp-empty-state hidden>
            <span class="bp-builder-empty-emoji" aria-hidden="true">✨</span>
            <p data-bp-empty-copy>No items for this pose yet ✨</p>
          </div>
        </section>

        <!-- RIGHT: CANVAS -->
        <section class="bp-builder-canvas-panel">
          <div class="bp-builder-canvas-toolbar">
            <span class="bp-builder-canvas-hint">Tap an item, then drag it around.</span>

            <div class="bp-builder-toolbar-actions">
              <button type="button" class="bp-builder-tool-btn" data-bp-undo disabled title="Undo">
                ↶ <span>Undo</span>
              </button>
              <button type="button" class="bp-builder-tool-btn" data-bp-redo disabled title="Redo">
                ↷ <span>Redo</span>
              </button>
              <button type="button" class="bp-builder-tool-btn" data-bp-reset title="Reset">
                ↺ <span>Reset</span>
              </button>
            </div>
          </div>

          <div class="bp-builder-canvas-wrap">
            <div class="bp-builder-canvas" data-bp-canvas>
              <div class="bp-builder-speech-bubble" data-bp-bubble hidden>
                Hi! Dress me up!
              </div>

              <img
                class="bp-builder-base-character"
                data-bp-base-character
                src=""
                alt=""
                draggable="false"
              >

              <div class="bp-builder-sticker-layer" data-bp-sticker-layer></div>
            </div>
          </div>

          <p class="bp-builder-mobile-help">
            Drag stickers to move them. Use the corner handle to resize and the round handle to rotate.
          </p>
        </section>
      </div>

      <div class="bp-builder-mobile-save-wrap">
        <button class="bp-builder-primary-btn bp-builder-primary-btn--full" type="button" data-bp-mobile-save>
          Save Buddy
        </button>
      </div>
    </div>
  </div>

  <!-- SHOPIFY METAOBJECT DATA -->
  <script type="application/json" data-bp-characters>
    [
      {% assign bp_characters = shop.metaobjects.character.values %}
      {% for character in bp_characters %}
        {
          "id": {{ character.system.id | json }},
          "handle": {{ character.system.handle | json }},
          "name": {{ character.name.value | default: character.system.handle | json }},
          "thumbnail": {% if character.thumbnail.value %}{{ character.thumbnail.value | image_url: width: 700 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>

  <script type="application/json" data-bp-poses>
    [
      {% assign bp_poses = shop.metaobjects.character_pose.values %}
      {% for pose in bp_poses %}
        {
          "id": {{ pose.system.id | json }},
          "handle": {{ pose.system.handle | json }},
          "name": {{ pose.name.value | default: pose.system.handle | json }},
          "characterHandle": {% if pose.character.value %}{{ pose.character.value.system.handle | json }}{% else %}null{% endif %},
          "baseImage": {% if pose.base_image.value %}{{ pose.base_image.value | image_url: width: 1400 | json }}{% else %}null{% endif %},
          "thumbnail": {% if pose.thumbnail.value %}{{ pose.thumbnail.value | image_url: width: 700 | json }}{% elsif pose.base_image.value %}{{ pose.base_image.value | image_url: width: 700 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>

  <script type="application/json" data-bp-items>
    [
      {% assign bp_items = shop.metaobjects.character_item.values %}
      {% for item in bp_items %}
        {
          "id": {{ item.system.id | json }},
          "handle": {{ item.system.handle | json }},
          "name": {{ item.name.value | default: item.system.handle | json }},
          "category": {{ item.category.value | default: 'Extras' | json }},
          "thumbnail": {% if item.thumbnail.value %}{{ item.thumbnail.value | image_url: width: 700 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>

  <script type="application/json" data-bp-assets>
    [
      {% assign bp_assets = shop.metaobjects.character_item_asset.values %}
      {% for asset in bp_assets %}
        {
          "id": {{ asset.system.id | json }},
          "handle": {{ asset.system.handle | json }},
          "itemHandle": {% if asset.item.value %}{{ asset.item.value.system.handle | json }}{% else %}null{% endif %},
          "poseHandle": {% if asset.pose.value %}{{ asset.pose.value.system.handle | json }}{% else %}null{% endif %},
          "image": {% if asset.image.value %}{{ asset.image.value | image_url: width: 1400 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>

  <style>
    #bp-builder-{{ section.id }} {
      --bp-radius-xl: 28px;
      --bp-radius-lg: 22px;
      --bp-radius-md: 16px;
      --bp-border: rgba(38, 32, 54, 0.10);
      --bp-border-strong: rgba(38, 32, 54, 0.18);
      --bp-muted: rgba(38, 32, 54, 0.62);
      --bp-shadow: 0 16px 50px rgba(50, 43, 76, 0.08);
      --bp-shadow-soft: 0 8px 24px rgba(50, 43, 76, 0.08);
      color: var(--bp-text);
      background:
        radial-gradient(circle at top left, color-mix(in srgb, var(--bp-accent-soft) 70%, transparent), transparent 32%),
        var(--bp-surface);
      padding: clamp(28px, 5vw, 72px) 18px;
    }

    #bp-builder-{{ section.id }} * {
      box-sizing: border-box;
    }

    #bp-builder-{{ section.id }} button,
    #bp-builder-{{ section.id }} input {
      font: inherit;
    }

    #bp-builder-{{ section.id }} button {
      -webkit-tap-highlight-color: transparent;
    }

    #bp-builder-{{ section.id }} .bp-builder-shell {
      width: min(1240px, 100%);
      margin: 0 auto;
    }

    #bp-builder-{{ section.id }} .bp-builder-view[hidden] {
      display: none !important;
    }

    #bp-builder-{{ section.id }} .bp-builder-intro {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 34px;
    }

    #bp-builder-{{ section.id }} .bp-builder-eyebrow {
      margin: 0 0 8px;
      color: var(--bp-accent);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    #bp-builder-{{ section.id }} .bp-builder-title {
      margin: 0;
      color: var(--bp-text);
      font-size: clamp(34px, 4vw, 58px);
      line-height: 1.03;
      letter-spacing: -0.035em;
      font-weight: 800;
    }

    #bp-builder-{{ section.id }} .bp-builder-title--compact {
      font-size: clamp(26px, 3vw, 40px);
    }

    #bp-builder-{{ section.id }} .bp-builder-subtitle {
      margin: 14px 0 0;
      color: var(--bp-muted);
      font-size: clamp(15px, 1.6vw, 18px);
      line-height: 1.6;
    }

    #bp-builder-{{ section.id }} .bp-builder-subtitle--center {
      text-align: center;
      margin-bottom: 24px;
    }

    /* CHARACTER CARDS */
    #bp-builder-{{ section.id }} .bp-builder-character-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 18px;
    }

    #bp-builder-{{ section.id }} .bp-builder-character-card,
    #bp-builder-{{ section.id }} .bp-builder-pose-card {
      position: relative;
      appearance: none;
      width: 100%;
      border: 1.5px solid var(--bp-border);
      border-radius: var(--bp-radius-lg);
      background: rgba(255, 255, 255, 0.88);
      color: var(--bp-text);
      cursor: pointer;
      padding: 16px;
      text-align: left;
      box-shadow: var(--bp-shadow-soft);
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease,
        background 180ms ease;
    }

    #bp-builder-{{ section.id }} .bp-builder-character-card:hover,
    #bp-builder-{{ section.id }} .bp-builder-pose-card:hover {
      transform: translateY(-5px);
      border-color: color-mix(in srgb, var(--bp-accent) 38%, transparent);
      box-shadow: 0 14px 32px rgba(50, 43, 76, 0.12);
    }

    #bp-builder-{{ section.id }} .bp-builder-character-card.is-selected,
    #bp-builder-{{ section.id }} .bp-builder-pose-card.is-selected {
      border-color: var(--bp-accent);
      box-shadow:
        0 0 0 3px color-mix(in srgb, var(--bp-accent) 14%, transparent),
        0 14px 32px rgba(50, 43, 76, 0.12);
      background: color-mix(in srgb, var(--bp-accent-soft) 28%, white);
    }

    #bp-builder-{{ section.id }} .bp-builder-character-thumb,
    #bp-builder-{{ section.id }} .bp-builder-pose-thumb {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: calc(var(--bp-radius-lg) - 7px);
      background:
        radial-gradient(circle at 50% 38%, #ffffff, color-mix(in srgb, var(--bp-accent-soft) 34%, white));
      display: grid;
      place-items: center;
      overflow: hidden;
      margin-bottom: 13px;
    }

    #bp-builder-{{ section.id }} .bp-builder-character-thumb img,
    #bp-builder-{{ section.id }} .bp-builder-pose-thumb img {
      width: 88%;
      height: 88%;
      object-fit: contain;
      user-select: none;
      pointer-events: none;
    }

    #bp-builder-{{ section.id }} .bp-builder-placeholder-art {
      width: 72px;
      height: 72px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      background: var(--bp-accent-soft);
      font-size: 34px;
    }

    #bp-builder-{{ section.id }} .bp-builder-card-name {
      display: block;
      font-size: 17px;
      font-weight: 800;
    }

    #bp-builder-{{ section.id }} .bp-builder-card-meta {
      display: block;
      margin-top: 4px;
      color: var(--bp-muted);
      font-size: 13px;
    }

    #bp-builder-{{ section.id }} .bp-builder-selected-badge {
      position: absolute;
      top: 26px;
      right: 26px;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      background: var(--bp-accent);
      color: white;
      font-size: 15px;
      font-weight: 900;
      opacity: 0;
      transform: scale(0.7);
      transition: 180ms ease;
    }

    #bp-builder-{{ section.id }} .is-selected .bp-builder-selected-badge {
      opacity: 1;
      transform: scale(1);
    }

    #bp-builder-{{ section.id }} .bp-builder-step-actions {
      display: flex;
      justify-content: center;
      margin-top: 28px;
    }

    #bp-builder-{{ section.id }} .bp-builder-primary-btn,
    #bp-builder-{{ section.id }} .bp-builder-save-btn {
      appearance: none;
      border: 0;
      border-radius: 999px;
      background: var(--bp-accent);
      color: white;
      min-height: 50px;
      padding: 0 24px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 10px 28px color-mix(in srgb, var(--bp-accent) 28%, transparent);
      transition: transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
    }

    #bp-builder-{{ section.id }} .bp-builder-primary-btn:hover:not(:disabled),
    #bp-builder-{{ section.id }} .bp-builder-save-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 34px color-mix(in srgb, var(--bp-accent) 34%, transparent);
    }

    #bp-builder-{{ section.id }} .bp-builder-primary-btn:disabled {
      opacity: 0.42;
      cursor: not-allowed;
      box-shadow: none;
    }

    /* TOP BAR */
    #bp-builder-{{ section.id }} .bp-builder-topbar {
      display: grid;
      grid-template-columns: minmax(110px, 1fr) auto minmax(110px, 1fr);
      align-items: center;
      gap: 18px;
      margin-bottom: 26px;
    }

    #bp-builder-{{ section.id }} .bp-builder-topbar-copy {
      text-align: center;
    }

    #bp-builder-{{ section.id }} .bp-builder-topbar-copy .bp-builder-eyebrow {
      margin-bottom: 5px;
    }

    #bp-builder-{{ section.id }} .bp-builder-back-btn,
    #bp-builder-{{ section.id }} .bp-builder-link-btn,
    #bp-builder-{{ section.id }} .bp-builder-tool-btn {
      appearance: none;
      border: 1px solid var(--bp-border);
      background: rgba(255,255,255,0.82);
      color: var(--bp-text);
      cursor: pointer;
      border-radius: 999px;
      min-height: 42px;
      padding: 0 15px;
      font-weight: 750;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    #bp-builder-{{ section.id }} .bp-builder-back-btn {
      justify-self: start;
    }

    #bp-builder-{{ section.id }} .bp-builder-back-btn:hover,
    #bp-builder-{{ section.id }} .bp-builder-link-btn:hover,
    #bp-builder-{{ section.id }} .bp-builder-tool-btn:hover:not(:disabled) {
      transform: translateY(-1px);
      border-color: var(--bp-border-strong);
      background: white;
    }

    #bp-builder-{{ section.id }} .bp-builder-save-btn {
      justify-self: end;
      min-height: 44px;
      padding-inline: 19px;
    }

    #bp-builder-{{ section.id }} .bp-builder-topbar-spacer {
      display: block;
      width: 110px;
    }

    /* POSES */
    #bp-builder-{{ section.id }} .bp-builder-pose-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 18px;
      max-width: 960px;
      margin: 0 auto;
    }

    /* BUILDER */
    #bp-builder-{{ section.id }} .bp-builder-pose-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      background: rgba(255,255,255,0.75);
      border: 1px solid var(--bp-border);
      border-radius: var(--bp-radius-md);
      padding: 11px 14px 11px 17px;
      margin-bottom: 14px;
    }

    #bp-builder-{{ section.id }} .bp-builder-pose-summary-copy {
      display: flex;
      align-items: baseline;
      gap: 9px;
    }

    #bp-builder-{{ section.id }} .bp-builder-pose-summary-label {
      color: var(--bp-muted);
      font-size: 13px;
    }

    #bp-builder-{{ section.id }} .bp-builder-link-btn {
      min-height: 36px;
      padding-inline: 13px;
      font-size: 13px;
    }

    #bp-builder-{{ section.id }} .bp-builder-workspace {
      display: grid;
      grid-template-columns: minmax(130px, 0.8fr) minmax(280px, 1.5fr) minmax(420px, 2.35fr);
      min-height: 650px;
      border: 1px solid var(--bp-border);
      border-radius: var(--bp-radius-xl);
      overflow: hidden;
      background: rgba(255,255,255,0.76);
      box-shadow: var(--bp-shadow);
    }

    #bp-builder-{{ section.id }} .bp-builder-category-panel,
    #bp-builder-{{ section.id }} .bp-builder-library-panel {
      border-right: 1px solid var(--bp-border);
    }

    #bp-builder-{{ section.id }} .bp-builder-category-panel {
      padding: 22px 14px;
      background: color-mix(in srgb, var(--bp-accent-soft) 16%, white);
    }

    #bp-builder-{{ section.id }} .bp-builder-library-panel {
      padding: 22px;
      overflow: auto;
      max-height: 760px;
      background: rgba(255,255,255,0.78);
    }

    #bp-builder-{{ section.id }} .bp-builder-panel-label {
      margin: 0 0 11px;
      color: var(--bp-muted);
      font-size: 11px;
      font-weight: 850;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #bp-builder-{{ section.id }} .bp-builder-category-list {
      display: grid;
      gap: 8px;
    }

    #bp-builder-{{ section.id }} .bp-builder-category {
      appearance: none;
      border: 1px solid transparent;
      border-radius: 14px;
      width: 100%;
      min-height: 58px;
      padding: 10px 9px;
      background: transparent;
      color: var(--bp-muted);
      display: grid;
      grid-template-columns: 28px 1fr;
      align-items: center;
      gap: 8px;
      text-align: left;
      cursor: pointer;
      font-weight: 750;
      transition: 160ms ease;
    }

    #bp-builder-{{ section.id }} .bp-builder-category:hover {
      background: rgba(255,255,255,0.78);
      color: var(--bp-text);
    }

    #bp-builder-{{ section.id }} .bp-builder-category.is-active {
      color: var(--bp-text);
      background: white;
      border-color: color-mix(in srgb, var(--bp-accent) 28%, transparent);
      box-shadow: 0 7px 18px rgba(50,43,76,0.07);
    }

    #bp-builder-{{ section.id }} .bp-builder-category-icon {
      font-size: 20px;
      line-height: 1;
      text-align: center;
    }

    #bp-builder-{{ section.id }} .bp-builder-panel-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    #bp-builder-{{ section.id }} .bp-builder-panel-heading .bp-builder-panel-label {
      margin-bottom: 3px;
    }

    #bp-builder-{{ section.id }} .bp-builder-panel-title {
      margin: 0;
      font-size: 24px;
      line-height: 1.1;
      font-weight: 850;
      letter-spacing: -0.02em;
    }

    #bp-builder-{{ section.id }} .bp-builder-item-count {
      white-space: nowrap;
      color: var(--bp-muted);
      font-size: 12px;
    }

    #bp-builder-{{ section.id }} .bp-builder-item-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    #bp-builder-{{ section.id }} .bp-builder-item-card {
      appearance: none;
      border: 1px solid var(--bp-border);
      border-radius: 15px;
      background: white;
      padding: 10px;
      color: var(--bp-text);
      text-align: left;
      cursor: pointer;
      transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
    }

    #bp-builder-{{ section.id }} .bp-builder-item-card:hover {
      transform: translateY(-3px);
      border-color: color-mix(in srgb, var(--bp-accent) 32%, transparent);
      box-shadow: var(--bp-shadow-soft);
    }

    #bp-builder-{{ section.id }} .bp-builder-item-thumb {
      display: grid;
      place-items: center;
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 11px;
      margin-bottom: 9px;
      background:
        linear-gradient(45deg, rgba(120,120,140,0.04) 25%, transparent 25%),
        linear-gradient(-45deg, rgba(120,120,140,0.04) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, rgba(120,120,140,0.04) 75%),
        linear-gradient(-45deg, transparent 75%, rgba(120,120,140,0.04) 75%);
      background-size: 18px 18px;
      background-position: 0 0, 0 9px, 9px -9px, -9px 0px;
    }

    #bp-builder-{{ section.id }} .bp-builder-item-thumb img {
      width: 88%;
      height: 88%;
      object-fit: contain;
      user-select: none;
      pointer-events: none;
    }

    #bp-builder-{{ section.id }} .bp-builder-item-name {
      display: block;
      font-size: 13px;
      font-weight: 800;
      line-height: 1.3;
    }

    #bp-builder-{{ section.id }} .bp-builder-empty-state {
      text-align: center;
