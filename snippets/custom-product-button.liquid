{% comment %}
  Custom product button.

  Usage inside your product form area (for example Dawn's sections/main-product.liquid):

  {% render 'custom-product-button',
    product: product,
    product_form_id: product_form_id
  %}
{% endcomment %}

{% liquid
  assign personalization_type = product.metafields.custom.dikado_personalization_type.value | strip
  if personalization_type == blank and product.metafields.custom.customizer_enabled.value == true
    assign personalization_type = 'design_editor'
  endif
%}
{% if product and personalization_type == 'design_editor' or product and personalization_type == 'photo_upload' %}
  <button
    type="button"
    class="button button--secondary customizer-launch-button"
    {% if personalization_type == 'photo_upload' %}data-photo-upload-open{% else %}data-customizer-open{% endif %}
    data-personalization-type="{{ personalization_type | escape }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle | escape }}"
    data-product-url="{{ product.url }}"
    {% if product_form_id != blank %}
      data-product-form-id="{{ product_form_id | escape }}"
    {% endif %}
    aria-haspopup="dialog"
  >
    Customize This Product
  </button>
{% endif %}
